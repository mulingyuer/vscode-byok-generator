{
  "name": "vscode-byok-generator",
  "description": "Visual Config Generator for VS Code Copilot BYOK & Custom Endpoints.",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "oxfmt src/",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@vicons/ionicons5": "^0.13.0",
    "codemirror": "^6.0.2",
    "naive-ui": "^2.45.0",
    "openai": "^7.4.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.78.0",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  }
}